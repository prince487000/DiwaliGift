<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Diwali 2026</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="scene">

    <h1>🪔 Happy Diwali 🪔</h1>

    <h2>✨ शुभ दीपावली ✨</h2>

    <div class="year">2026</div>

    <p class="info">
        May your life shine as bright as these beautiful lights!<br>
        Let's celebrate the festival of happiness and love. ❤️
    </p>

    <!-- DIYAS -->

    <div class="diya-container">

        <div class="diya-wrap">
            <div class="diya-glow"></div>
            <div class="flame"></div>
            <div class="wick"></div>
            <div class="oil"></div>
            <div class="diya"></div>
            <div class="bowl"></div>
        </div>

        <div class="diya-wrap">
            <div class="diya-glow"></div>
            <div class="flame"></div>
            <div class="wick"></div>
            <div class="oil"></div>
            <div class="diya"></div>
            <div class="bowl"></div>
        </div>

        <div class="diya-wrap">
            <div class="diya-glow"></div>
            <div class="flame"></div>
            <div class="wick"></div>
            <div class="oil"></div>
            <div class="diya"></div>
            <div class="bowl"></div>
        </div>

    </div>

    <!-- BUTTONS -->

    <div class="buttons">

        <button class="btn" onclick="celebrate()">
            🎆 Celebrate Diwali
        </button>

        <button class="btn" onclick="showWish()">
            💌 Surprise Wishes
        </button>

        <button class="btn" onclick="skyFireworks()">
            🎇 Light Up The Sky
        </button>

    </div>

    <!-- WISH BOX -->

    <div class="wish-box" id="wishBox">

        <h2 id="wishTitle">✨ Happy Diwali ✨</h2>

        <p id="wishText">
            May this Diwali bring happiness and prosperity!
        </p>

        <button class="btn" onclick="showWish()">
            Next Wish ❤️
        </button>

    </div>

    <canvas id="fireworks"></canvas>

</div>

<script src="script.js"></script>

</body>
</html>
